{
  "name": "project-eleven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "concurrently -k -s first -n app,api \"next dev\" \"npx json-server -p 3210 db.json5\"",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --sequence.concurrent --sequence.shuffle.tests",
    "test:unit:coverage": "vitest run --sequence.concurrent --sequence.shuffle.tests --coverage",
    "test:integration": "playwright test --ui",
    "test:integration:headless": "playwright test"
  },
  "dependencies": {
    "json-server": "^1.0.0-beta.15",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
